{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "instructions": [".cursor/rules/*.md", "CLAUDE.md"],
  "lsp": {
    "typescript": {
      "disabled": true
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  },
  "keybinds": {
    "session_child_cycle": "ctrl+shift+right",
    "session_child_cycle_reverse": "ctrl+shift+left"
  },
  "agent": {
    "researcher": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4.5",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  }
}
